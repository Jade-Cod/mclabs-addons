{
	"schemaVersion": 1,
	"id": "labsaddons",
	"version": "${version}",
	"name": "MCLabs Addons",
	"description": "MCLabs server HUD addons: fish-bite indicator, chum & booster timers, mini-event/pit trackers, and Lab Wars revenue boosters. Configurable, draggable HUD widgets.",
	"authors": [
		"Jade"
	],
	"license": "MIT",
	"icon": "assets/labsaddons/icon.png",
	"environment": "client",
	"entrypoints": {
		"client": [
			"dev.jade.labsaddons.LabsAddonsClient"
		],
		"modmenu": [
			"dev.jade.labsaddons.config.LabsAddonsModMenu"
		]
	},
	"mixins": [
		"labsaddons.mixins.json"
	],
	"breaks": {
		"fishbite": "*"
	},
	"depends": {
		"fabricloader": ">=0.17.3",
		"minecraft": "=${minecraft_version}",
		"java": ">=25",
		"fabric-api": "*"
	},
	"recommends": {
		"modmenu": "*",
		"cloth-config": "*"
	}
}